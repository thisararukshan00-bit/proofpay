# Copy to .env and fill in your own values. NEVER commit .env.
# Everything is optional: with no values the app runs on a local JSON file and the demo verifier,
# and the "Reserve the money" step explains that PayPal sandbox credentials are missing.

# ---------- PayPal (SANDBOX ONLY) ----------
# developer.paypal.com > Apps & Credentials > Sandbox > your app. The app always calls api-m.sandbox.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal does not support LKR. Keep USD.
CURRENCY=USD

# ---------- AI (optional; leave empty for the labelled Demo verifier) ----------
# Option 1: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Option 2: any OpenAI-compatible chat endpoint (base URL ends before /chat/completions)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=90

# ---------- GitHub (optional) ----------
# A token with no scopes only raises the API rate limit (60/hour without one).
GITHUB_TOKEN=

# ---------- Storage ----------
# auto = MongoDB if MONGODB_URI works, otherwise a local JSON file; mongo = MongoDB only; local = JSON file only
STORAGE_MODE=auto
MONGODB_URI=
MONGODB_DB=proofpay

# ---------- Development only ----------
# 1 = in-memory PayPal SIMULATOR (not PayPal, no money, loud red banners). Never record the demo video with this on.
PROOFPAY_FAKE_PAYPAL=
ALLOW_DEMO_RESET=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
